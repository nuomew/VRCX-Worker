{
    "$schema": "node_modules/wrangler/config-schema.json",
    // Local dev/test Worker config only (Vitest / Miniflare). Production deploys MUST use repository root `wrangler.jsonc`.
    "name": "vrcx-cloud-local-test",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-01",
    // Static frontend assets served directly from Cloudflare edge at zero Worker request cost.
    // Phase 0 serves the diagnostics page; Phase 1 will point to the built VRCX Web SPA.
    "assets": {
        "directory": "./public",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/health", "/poc/*", "/api/*", "/ws/*"]
    },
    // Omit database_id to enable Cloudflare Automatic Resource Provisioning on one-click deploy.
    "d1_databases": [
        {
            "binding": "DB_CORE",
            "database_name": "vrcx-core",
            "migrations_dir": "migrations/core"
        },
        {
            "binding": "DB_GAMELOG",
            "database_name": "vrcx-gamelog",
            "migrations_dir": "migrations/gamelog"
        },
        {
            "binding": "DB_FEED",
            "database_name": "vrcx-feed",
            "migrations_dir": "migrations/feed"
        },
        {
            "binding": "DB_CACHE",
            "database_name": "vrcx-cache",
            "migrations_dir": "migrations/cache"
        },
        {
            "binding": "DB_LEGACY",
            "database_name": "vrcx-legacy",
            "migrations_dir": "migrations/legacy"
        },
        {
            "binding": "DB_CHAT",
            "database_name": "vrcx-chat",
            "migrations_dir": "migrations/chat"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "AGENT_HUB",
                "class_name": "AgentHubDO"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["AgentHubDO"]
        }
    ],
    "triggers": {
        "crons": ["* * * * *"]
    },
    "r2_buckets": [
        {
            "binding": "R2_MEDIA",
            "bucket_name": "vrcx-media-local-test"
        }
    ]
}
