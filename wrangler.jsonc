{
    "$schema": "cloud/node_modules/wrangler/config-schema.json",
    "name": "vrcx-cloud",
    "main": "cloud/src/index.ts",
    "compatibility_date": "2026-11-01",
    // Root-level Wrangler config enables zero-configuration one-click deployment directly from
    // the repository root in Cloudflare Workers Builds (no manual Root directory override required).
    "assets": {
        "directory": "./cloud/public",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/health", "/poc/*", "/api/*", "/ws/*"]
    },
    // Omit database_id so Cloudflare automatically provisions all 3 Free-tier D1 shards on deploy.
    "d1_databases": [
        {
            "binding": "DB_CORE",
            "database_name": "vrcx-core",
            "migrations_dir": "cloud/migrations/core"
        },
        {
            "binding": "DB_GAMELOG",
            "database_name": "vrcx-gamelog",
            "migrations_dir": "cloud/migrations/gamelog"
        },
        {
            "binding": "DB_FEED",
            "database_name": "vrcx-feed",
            "migrations_dir": "cloud/migrations/feed"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "AGENT_HUB",
                "class_name": "AgentHubDO"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["AgentHubDO"]
        }
    ]
}
