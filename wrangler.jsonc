{
    "$schema": "cloud/node_modules/wrangler/config-schema.json",
    "name": "vrcx-cloud",
    "main": "cloud/src/index.ts",
    "compatibility_date": "2026-11-01",
    "compatibility_flags": ["nodejs_compat"],
    // Automatically build the VRCX Web SPA during `npx wrangler deploy` so zero Dashboard build-command config is required.
    "build": {
        "command": "npm run build:web"
    },
    // Serves the full built VRCX Vue SPA (--mode web) directly from Cloudflare edge at zero Worker request cost.
    "assets": {
        "directory": "./build/web",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/health", "/poc/*", "/api/*", "/ws/*"]
    },
    // Omit database_id so Cloudflare Automatic Resource Provisioning creates all 3 Free-tier D1 shards on deploy.
    "d1_databases": [
        {
            "binding": "DB_CORE",
            "database_name": "vrcx-core",
            "migrations_dir": "cloud/migrations/core"
        },
        {
            "binding": "DB_GAMELOG",
            "database_name": "vrcx-gamelog",
            "migrations_dir": "cloud/migrations/gamelog"
        },
        {
            "binding": "DB_FEED",
            "database_name": "vrcx-feed",
            "migrations_dir": "cloud/migrations/feed"
        },
        {
            "binding": "DB_CACHE",
            "database_name": "vrcx-cache",
            "migrations_dir": "cloud/migrations/cache"
        },
        {
            "binding": "DB_LEGACY",
            "database_name": "vrcx-legacy",
            "migrations_dir": "cloud/migrations/legacy"
        },
        {
            "binding": "DB_CHAT",
            "database_name": "vrcx-chat",
            "migrations_dir": "cloud/migrations/chat"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "AGENT_HUB",
                "class_name": "AgentHubDO"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["AgentHubDO"]
        }
    ],
    // Built-in Cloudflare Workers AI binding (10,000 free Neurons/day on Workers Free plan, no card required).
    "ai": {
        "binding": "AI"
    },
    // R2 is not declared here by default so first-time Git deploys succeed without an R2 subscription.
    // `keep_vars` + `unsafe.metadata.keep_bindings` preserve any existing Secrets, Dashboard vars, and
    // manually-bound R2 buckets (e.g. `R2_MEDIA`) across every subsequent Git auto-deploy.
    // You may also uncomment `r2_buckets` below to manage a specific bucket in Git:
    // "r2_buckets": [
    //     {
    //         "binding": "R2_MEDIA",
    //         "bucket_name": "vrcx-media"
    //     }
    // ],
    "keep_vars": true,
    "unsafe": {
        "metadata": {
            "keep_bindings": ["secret_text", "secret_key", "plain_text", "json", "r2_bucket", "hyperdrive", "ai"]
        }
    },
    // 1-minute cron tick gated inside scheduled() by user-configured syncIntervalSeconds (0 external fetch when idle/web active).
    "triggers": {
        "crons": ["* * * * *"]
    }
}
